<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app spawns the bundled DIALibGen CLI, which loads its own collected
       dylib closure (OpenMS, arrow, onnxruntime, libomp, ...). Under the hardened runtime
       these are all re-signed with our Developer ID, but disabling library
       validation is the standard safety net for an app that ships third-party
       native libraries, and notarization accepts it. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
