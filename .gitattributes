# Vendored and hashed sources keep their bytes on every platform (their
# manifests record SHA-256 digests; a CRLF checkout on Windows would change them).
src/odia-core/** text eol=lf
test/odia-core/** text eol=lf
third_party/** -text
# Binary test fixtures.
test/data/mzpeak/** binary
# The instrument defaults: the recipe records each file's FNV-1a64, which must
# not depend on the platform's checkout.
data/instruments/** text eol=lf
